# PostgreSQL values used by the local Docker Compose stack.
POSTGRES_USER=inosluban
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=inosluban

# The HTTPS URL assigned to this machine by Tailscale.
# Replace the placeholder after running `tailscale status`.
APP_BASE_URL=https://inosluban-local.your-tailnet.ts.net
APP_TIMEZONE=Asia/Manila
TS_HOSTNAME=inosluban-local

# Create a reusable, preferably pre-approved, Tailscale auth key.
TS_AUTHKEY=tskey-auth-replace-me

# Generate these with the commands in README.md.
FACE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
FACE_ENROLLMENT_SETUP_TOKEN=replace-with-random-64-character-token
FACE_ADMIN_RECOVERY_TOKEN=replace-with-a-different-random-64-character-token

# Optional email settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Barangay Inosluban

# Optional AI integration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
